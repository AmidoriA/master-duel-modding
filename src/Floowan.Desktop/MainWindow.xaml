<Window x:Class="Floowan.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Floowan — Master Duel Card Art"
        Height="800" Width="1400"
        MinHeight="620" MinWidth="1100"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
  <Window.Resources>
    <ItemsPanelTemplate x:Key="CardListItemsPanel">
      <VirtualizingStackPanel/>
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="CardThumbnailItemsPanel">
      <WrapPanel/>
    </ItemsPanelTemplate>
    <DataTemplate x:Key="OfCardListItemTemplate">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding DisplayName}"/>
        <TextBlock Text="  [OF]" Foreground="#7DCEA0" FontWeight="SemiBold"
                   Visibility="{Binding IsOverframe, Converter={StaticResource BoolToVisibilityConverter}}"/>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="CardThumbnailItemTemplate">
      <StackPanel Width="92" Margin="3">
        <Border Width="76" Height="110" Background="#12161A" CornerRadius="2"
                BorderBrush="#3A4652" BorderThickness="1">
          <Grid>
            <Image Width="72" Height="104" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Loaded="CardThumbnailImage_Loaded"/>
            <TextBlock Text="OF" FontSize="9" FontWeight="SemiBold" Foreground="#7DCEA0"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0"
                       Visibility="{Binding IsOverframe, Converter={StaticResource BoolToVisibilityConverter}}"/>
          </Grid>
        </Border>
        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                   TextAlignment="Center" FontSize="10" Margin="0,4,0,0" MaxWidth="92"
                   ToolTip="{Binding DisplayName}"/>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>
  <!-- Root grid: busy overlay blocks input without Window.IsEnabled (which greys ListBox white). -->
  <Grid>
  <DockPanel x:Name="MainContent" Margin="16">
    <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" Padding="12" CornerRadius="4" Margin="0,0,0,12">
      <Expander x:Name="HomePathsExpander" IsExpanded="True" ExpandDirection="Down">
        <Expander.Header>
          <StackPanel Orientation="Vertical" Margin="4,0,0,0">
            <TextBlock Text="Floowan" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Card art replacement for Yu-Gi-Oh! Master Duel"
                       Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
          </StackPanel>
        </Expander.Header>
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <DockPanel>
              <TextBlock Text="LocalData path" Width="100" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
              <TextBox x:Name="GamePathBox" IsReadOnly="True"/>
            </DockPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Vertical" Margin="12,0,0,0">
            <Button Content="Discover Steam" Click="DiscoverSteam_Click" Margin="0,0,0,6"/>
            <Button Content="Browse LocalData…" Click="BrowseGamePath_Click"/>
          </StackPanel>
        </Grid>
      </Expander>
    </Border>

    <StatusBar DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedBrush}"/>
      </StatusBarItem>
    </StatusBar>

    <TabControl x:Name="MainTabs" Background="{StaticResource BgBrush}" BorderBrush="#3A4652" SelectionChanged="MainTabs_SelectionChanged">
      <TabItem x:Name="CardArtTab" Header="Card Art">
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Background="{StaticResource PanelBrush}" Padding="12" CornerRadius="4">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Cards" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox x:Name="SearchBox" Width="260" KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged"/>
                <Button Content="Search" Click="Search_Click" Background="{StaticResource AccentBrush}"/>
                <CheckBox x:Name="FavoritesOnlyBox" Content="Favorites" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" Margin="4,0,0,0"/>
                <CheckBox x:Name="SearchDescBox" Content="Include description" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" Margin="8,0,0,0"/>
              </StackPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="View" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
                <RadioButton x:Name="CardArtViewListRadio" Content="List" GroupName="CardResultsView"
                             IsChecked="True" Checked="CardResultsViewMode_Changed"/>
                <RadioButton x:Name="CardArtViewThumbRadio" Content="Thumbnails" GroupName="CardResultsView"
                             Checked="CardResultsViewMode_Changed"/>
              </StackPanel>
              <ListBox x:Name="CardList"
                       DisplayMemberPath="DisplayName"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       SelectionChanged="CardList_SelectionChanged"/>
            </DockPanel>
          </Border>

          <Border Grid.Column="2" Background="{StaticResource PanelBrush}" Padding="12" CornerRadius="4">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Selected card" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Select image…" Click="SelectImage_Click"/>
                <Button Content="Replace art" Click="Replace_Click" Background="{StaticResource AccentBrush}"
                        ToolTip="Opens a before/after comparison. Confirm writes to the game (with backup); Cancel aborts."/>
                <Button Content="Extract PNG" Click="Extract_Click"/>
                <Button Content="Restore backup" Click="Restore_Click"/>
                <Button Content="Open in Over-Frame" Click="CardArtOpenInOverFrame_Click" Margin="12,0,0,0"
                        ToolTip="Switch to Over-frame with this card selected."/>
                <Button Content="Open in Database View" Click="CardArtOpenInDatabase_Click"
                        ToolTip="Switch to Database with this card selected."/>
              </StackPanel>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock x:Name="CardTitleText" Text="(none selected)" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock x:Name="CardMetaText" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                  <TextBlock x:Name="ImagePathText" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Row="1" Background="#12161A" Margin="0,12,0,0" CornerRadius="4">
                  <Grid>
                    <Image x:Name="CurrentArtImage" Stretch="Uniform" Margin="8"
                           Cursor="Hand"
                           ToolTip="Click to enlarge"
                           MouseLeftButtonUp="CardPreviewImage_MouseLeftButtonUp"/>
                    <Image x:Name="ReplacementImage" Stretch="Uniform" Margin="8" Opacity="0.0"
                           IsHitTestVisible="False"
                           Cursor="Hand"
                           ToolTip="Click to enlarge"
                           MouseLeftButtonUp="CardPreviewImage_MouseLeftButtonUp"/>
                  </Grid>
                </Border>
                <TextBlock Grid.Row="2" x:Name="DetailText" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
              </Grid>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem x:Name="OverFrameTab" Header="Over-frame">
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Background="{StaticResource PanelBrush}" Padding="12" CornerRadius="4">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Over-frame cards" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock x:Name="OfGateStatusText" DockPanel.Dock="Top"
                         Text="Gate: not scanned yet"
                         Foreground="{StaticResource MutedBrush}"
                         Margin="0,0,0,8" TextWrapping="Wrap"/>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox x:Name="OfSearchBox" Width="220" KeyDown="OfSearchBox_KeyDown" TextChanged="OfSearchBox_TextChanged"/>
                <Button Content="Search" Click="OfSearch_Click" Background="{StaticResource AccentBrush}"/>
                <CheckBox x:Name="OfOverframeOnlyBox" Content="Over-frame only" VerticalAlignment="Center"
                          Foreground="{StaticResource TextBrush}" Margin="4,0,0,0"
                          Checked="OfFilter_Changed" Unchecked="OfFilter_Changed"/>
                <CheckBox x:Name="OfFavoritesOnlyBox" Content="Favorites" VerticalAlignment="Center"
                          Foreground="{StaticResource TextBrush}" Margin="8,0,0,0"/>
                <CheckBox x:Name="OfSearchDescBox" Content="Include description" VerticalAlignment="Center"
                          Foreground="{StaticResource TextBrush}" Margin="8,0,0,0"/>
              </StackPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="View" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
                <RadioButton x:Name="OfViewListRadio" Content="List" GroupName="OfResultsView"
                             IsChecked="True" Checked="OfResultsViewMode_Changed"/>
                <RadioButton x:Name="OfViewThumbRadio" Content="Thumbnails" GroupName="OfResultsView"
                             Checked="OfResultsViewMode_Changed"/>
              </StackPanel>
              <ListBox x:Name="OfCardList"
                       ItemTemplate="{StaticResource OfCardListItemTemplate}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       SelectionChanged="OfCardList_SelectionChanged"/>
            </DockPanel>
          </Border>

          <Border Grid.Column="2" Background="{StaticResource PanelBrush}" Padding="12" CornerRadius="4">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Over-frame editor" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Button Content="Auto-create &amp; apply" Click="OfAutoCreateAndApply_Click" Background="{StaticResource AccentBrush}"/>
                <Button Content="Preview" Click="OfPreview_Click"/>
                <Button Content="Restore backups" Click="OfRestore_Click"/>
                <Button Content="Open in Card Art" Click="OfOpenInCardArt_Click" Margin="12,0,0,0"
                        ToolTip="Switch to Card Art with this card selected."/>
                <Button Content="Open in Database View" Click="OfOpenInDatabase_Click"
                        ToolTip="Switch to Database with this card selected."/>
              </WrapPanel>
              <Expander DockPanel.Dock="Bottom"
                        Header="Advanced (manual apply / gate)"
                        IsExpanded="False"
                        ExpandDirection="Down"
                        Foreground="{StaticResource MutedBrush}"
                        Margin="0,8,0,0"
                        ToolTip="Collapse to hide custom overframe art and gate tools.">
                <WrapPanel Margin="0,8,0,0">
                  <Button Content="Custom overframe art" Click="OfCustomOverframeArt_Click"/>
                  <Button Content="Enable gate only" Click="OfEnableGate_Click"/>
                  <Button Content="Force disable gate"
                          Click="OfForceDisableGate_Click"
                          ToolTip="Remove this card's art-id from of_card_asset so the game no longer treats it as over-framed. Does not restore the card texture — use Restore backups for that."/>
                </WrapPanel>
              </Expander>
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Frame" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
                <ComboBox x:Name="OfFrameStyleBox" Width="220">
                  <ComboBoxItem Content="Effect" Tag="Effect"/>
                  <ComboBoxItem Content="Normal" Tag="Normal"/>
                  <ComboBoxItem Content="Fusion" Tag="Fusion"/>
                  <ComboBoxItem Content="Synchro" Tag="Synchro"/>
                  <ComboBoxItem Content="Xyz" Tag="Xyz"/>
                  <ComboBoxItem Content="Ritual" Tag="Ritual"/>
                  <ComboBoxItem Content="Spell" Tag="Spell"/>
                  <ComboBoxItem Content="Trap" Tag="Trap"/>
                  <ComboBoxItem Content="Link" Tag="Link"/>
                  <ComboBoxItem Content="Token" Tag="Token"/>
                  <ComboBoxItem Content="Pendulum Normal" Tag="PendulumNormal"/>
                  <ComboBoxItem Content="Pendulum Effect" Tag="PendulumEffect"/>
                  <ComboBoxItem Content="Pendulum Fusion" Tag="PendulumFusion"/>
                  <ComboBoxItem Content="Pendulum Synchro" Tag="PendulumSynchro"/>
                  <ComboBoxItem Content="Pendulum Xyz" Tag="PendulumXyz"/>
                  <ComboBoxItem Content="Pendulum Ritual" Tag="PendulumRitual"/>
                  <ComboBoxItem Content="Pendulum Token" Tag="PendulumToken"/>
                </ComboBox>
                <TextBlock x:Name="OfActionStatusText"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"
                           TextWrapping="Wrap"
                           MaxWidth="360"/>
              </StackPanel>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="OfCardTitleText" Text="(none selected)" FontSize="15" FontWeight="SemiBold"
                             TextWrapping="Wrap" VerticalAlignment="Top"/>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12,2,0,0"
                              MaxWidth="300">
                    <TextBlock x:Name="OfCardMetaText" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" TextAlignment="Right" TextWrapping="Wrap"/>
                    <TextBlock x:Name="OfGateEntryText" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" TextAlignment="Right" TextWrapping="Wrap" Margin="0,2,0,0"/>
                  </StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="#12161A" Margin="0,8,0,0" CornerRadius="4">
                  <Grid x:Name="OfPreviewGrid">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition x:Name="OfCurrentPreviewCol" Width="*"/>
                      <ColumnDefinition x:Name="OfReplacementPreviewCol" Width="0"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="OfCurrentArtImage" Stretch="Uniform" Margin="8"
                           Cursor="Hand"
                           ToolTip="Click to enlarge"
                           MouseLeftButtonUp="CardPreviewImage_MouseLeftButtonUp"/>
                    <Image x:Name="OfReplacementImage" Grid.Column="1" Stretch="Uniform" Margin="8" Opacity="0.0"
                           IsHitTestVisible="False"
                           Cursor="Hand"
                           ToolTip="Click to enlarge"
                           MouseLeftButtonUp="CardPreviewImage_MouseLeftButtonUp"/>
                  </Grid>
                </Border>
              </Grid>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem x:Name="DatabaseTab" Header="Database">
        <Grid Margin="0,8,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Border Background="{StaticResource PanelBrush}" Padding="12" CornerRadius="4" Margin="0,0,0,8">
            <StackPanel>
              <TextBlock Text="Filters" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                  <TextBlock Text="Card ID" Width="70" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                  <TextBox x:Name="DbFilterIdBox" Width="100" KeyDown="DbFilter_KeyDown" TextChanged="DbFilterText_Changed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                  <TextBlock Text="Name" Width="50" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                  <TextBox x:Name="DbFilterNameBox" Width="180" KeyDown="DbFilter_KeyDown" TextChanged="DbFilterText_Changed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                  <TextBlock Text="Description" Width="80" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                  <TextBox x:Name="DbFilterDescBox" Width="180" KeyDown="DbFilter_KeyDown" TextChanged="DbFilterText_Changed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                  <TextBlock Text="Favorite" Width="60" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                  <ComboBox x:Name="DbFilterFavoriteBox" Width="110" SelectedIndex="0"
                            SelectionChanged="DbFilterCombo_Changed">
                    <ComboBoxItem Content="Any"/>
                    <ComboBoxItem Content="Yes"/>
                    <ComboBoxItem Content="No"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                  <TextBlock Text="Backup" Width="55" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                  <ComboBox x:Name="DbFilterBackupBox" Width="110" SelectedIndex="0"
                            SelectionChanged="DbFilterCombo_Changed">
                    <ComboBoxItem Content="Any"/>
                    <ComboBoxItem Content="Has backup"/>
                    <ComboBoxItem Content="No backup"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                  <TextBlock Text="Modded name" Width="90" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                  <ComboBox x:Name="DbFilterModdedNameBox" Width="110" SelectedIndex="0"
                            SelectionChanged="DbFilterCombo_Changed">
                    <ComboBoxItem Content="Any"/>
                    <ComboBoxItem Content="Populated"/>
                    <ComboBoxItem Content="Empty"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                  <TextBlock Text="Modded desc" Width="90" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                  <ComboBox x:Name="DbFilterModdedDescBox" Width="110" SelectedIndex="0"
                            SelectionChanged="DbFilterCombo_Changed">
                    <ComboBoxItem Content="Any"/>
                    <ComboBoxItem Content="Populated"/>
                    <ComboBoxItem Content="Empty"/>
                  </ComboBox>
                </StackPanel>
              </WrapPanel>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="Apply filters" Click="DbApplyFilters_Click" Background="{StaticResource AccentBrush}"/>
                <Button Content="Clear filters" Click="DbClearFilters_Click"/>
                <Button x:Name="DbPrevPageButton" Content="Previous page" Click="DbPrevPage_Click" IsEnabled="False"/>
                <Button x:Name="DbNextPageButton" Content="Next page" Click="DbNextPage_Click" IsEnabled="False"/>
                <TextBlock x:Name="DbPageInfoText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.4*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="0.95*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}" Padding="12" CornerRadius="4">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Cards" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <DataGrid x:Name="DbCardGrid"
                          SelectionChanged="DbCardGrid_SelectionChanged"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="id" Binding="{Binding Id}" Width="70"/>
                    <DataGridTextColumn Header="name" Binding="{Binding Name}" Width="140"/>
                    <DataGridTextColumn x:Name="DbColCardType" Header="card_type" Binding="{Binding CardType}" Width="90"/>
                    <DataGridTextColumn x:Name="DbColCreatedAt" Header="created_at" Binding="{Binding CreatedAtDisplay}" Width="140"/>
                    <DataGridTextColumn Header="description" Binding="{Binding Description}" Width="180"/>
                    <DataGridTextColumn Header="modded_name" Binding="{Binding ModdedName}" Width="120"/>
                    <DataGridTextColumn Header="modded_description" Binding="{Binding ModdedDescription}" Width="140"/>
                    <DataGridTextColumn Header="bundle" Binding="{Binding Bundle}" Width="80"/>
                    <DataGridTextColumn Header="data_index" Binding="{Binding DataIndex}" Width="80"/>
                    <DataGridCheckBoxColumn Header="favorite" Binding="{Binding Favorite}" Width="70" IsReadOnly="True"/>
                    <DataGridCheckBoxColumn Header="has_backup" Binding="{Binding HasBackup}" Width="80" IsReadOnly="True"/>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" Padding="12" CornerRadius="4">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Record details" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="Open in Card Art" Click="DbOpenInCardArt_Click"/>
                  <Button Content="Open in Over-frame" Click="DbOpenInOverFrame_Click"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="120"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="id" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBox x:Name="DbEditIdBox" Grid.Row="0" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Text="name" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBox x:Name="DbEditNameBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="2" Text="description" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Top" Margin="0,6,0,8"/>
                    <TextBox x:Name="DbEditDescBox" Grid.Row="2" Grid.Column="1" Height="90" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="3" Text="modded_name" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBox x:Name="DbEditModdedNameBox" Grid.Row="3" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="4" Text="modded_description" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Top" Margin="0,6,0,8"/>
                    <TextBox x:Name="DbEditModdedDescBox" Grid.Row="4" Grid.Column="1" Height="90" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Margin="0,0,0,8"/>

                    <TextBlock x:Name="DbEditCardTypeLabel" Grid.Row="5" Text="card_type" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBox x:Name="DbEditCardTypeBox" Grid.Row="5" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,8"/>

                    <TextBlock x:Name="DbEditCreatedAtLabel" Grid.Row="6" Text="created_at" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBox x:Name="DbEditCreatedAtBox" Grid.Row="6" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="7" Text="bundle" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBox x:Name="DbEditBundleBox" Grid.Row="7" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="8" Text="data_index" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBox x:Name="DbEditDataIndexBox" Grid.Row="8" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="9" Text="favorite" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    <CheckBox x:Name="DbEditFavoriteBox" Grid.Row="9" Grid.Column="1" Content="Favorite" IsEnabled="False" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="10" Text="has_backup" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBox x:Name="DbEditHasBackupBox" Grid.Row="10" Grid.Column="1" IsReadOnly="True"/>
                  </Grid>
                </ScrollViewer>
              </DockPanel>
            </Border>

            <Border Grid.Column="4" Background="{StaticResource PanelBrush}" Padding="12" CornerRadius="4">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Card art" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock x:Name="DbArtMetaText" DockPanel.Dock="Top"
                           Text="Select a card to preview live art."
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <Border Background="#12161A" CornerRadius="4">
                  <Image x:Name="DbArtPreviewImage" Stretch="Uniform" Margin="8"/>
                </Border>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem x:Name="ToolsTab" Header="Tools">
        <Grid Margin="0,8,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Background="{StaticResource PanelBrush}" Padding="12" CornerRadius="4" Margin="0,0,0,8">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Card database" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock DockPanel.Dock="Top"
                         Text="Rebuild or incrementally refresh the master card catalog (database.db) from the Home LocalData path plus install StreamingAssets/AssetBundle (names, descriptions, bundles, card_type, created_at). Prefer LocalData downloads when both exist. Incremental mode skips any AssetBundle whose File.GetCreationTimeUtc is not after MAX(created_at) already stored in the database — those files are never opened."
                         Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="ToolsUpdateEntireDbButton" Content="Update entire DB"
                        Click="ToolsUpdateEntireDatabase_Click" Background="{StaticResource AccentBrush}"
                        Padding="12,4" Margin="0,0,8,0"/>
                <Button x:Name="ToolsUpdateNewFilesDbButton" Content="Update new files only"
                        Click="ToolsUpdateNewFilesDatabase_Click"
                        Padding="12,4" Margin="0,0,8,0"
                        ToolTip="Only open AssetBundles whose File.GetCreationTimeUtc is after the latest created_at in database.db; older files are skipped entirely."/>
              </StackPanel>
              <TextBlock x:Name="ToolsUpdateDbStatusText"
                         Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            </DockPanel>
          </Border>

          <Border Grid.Row="1" Background="{StaticResource PanelBrush}" Padding="12" CornerRadius="4" Margin="0,0,0,8">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="of_card_asset gate" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock DockPanel.Dock="Top"
                         Text="Locate the AssetBundle that contains TextAsset of_card_asset under LocalData/0000 and StreamingAssets, cache its id in user.db, and sync is_overframe flags from the live gate. Runs off the UI thread so the app stays responsive during the scan."
                         Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="ToolsScanOfCardAssetButton" Content="Scan / locate of_card_asset…"
                        Click="ToolsScanOfCardAsset_Click" Background="{StaticResource AccentBrush}"
                        Padding="12,4" Margin="0,0,8,0"
                        ToolTip="Find of_card_asset, cache the bundle id, and sync Over-frame flags from the gate. Long filesystem/AssetBundle work runs in the background."/>
              </StackPanel>
              <TextBlock x:Name="ToolsScanOfCardAssetStatusText"
                         Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            </DockPanel>
          </Border>

          <Border Grid.Row="2" Background="{StaticResource PanelBrush}" Padding="12" CornerRadius="4" Margin="0,0,0,8">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Over-frames after patch" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock DockPanel.Dock="Top"
                         Text="After a Master Duel update replaces of_card_asset, Floowan over-frames can drop out of the gate even when art backups remain. This scans user.db for cards Floowan previously applied OF to, re-writes applied OF canvases into live art bundles when needed, and appends gate entries without wiping official Konami over-frames."
                         Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="ToolsRestoreOverframesButton" Content="Restore overframes after patch"
                        Click="ToolsRestoreOverframesAfterPatch_Click" Background="{StaticResource AccentBrush}"
                        Padding="12,4" Margin="0,0,8,0"
                        ToolTip="Scan user.db for Floowan-applied over-frames, merge each art id into the current of_card_asset gate (additive — official OF entries are kept), and re-apply 704x1024 art from backups/cards/*-applied-overframe.png when live texture was reset. Skips cards that are already gated with OF-sized art. Does not restore the whole gate backup file."/>
              </StackPanel>
              <TextBlock x:Name="ToolsRestoreOverframesStatusText"
                         Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            </DockPanel>
          </Border>

          <Border Grid.Row="3" Background="{StaticResource PanelBrush}" Padding="12" CornerRadius="4">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Backups" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock DockPanel.Dock="Top"
                         Text="Browse original files saved before card art and over-frame changes."
                         Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="Backup folder" Width="100" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"/>
                <Button DockPanel.Dock="Right" Content="Open in Explorer" Click="ToolsOpenBackupRoot_Click"
                        Margin="8,0,0,0"/>
                <TextBox x:Name="ToolsBackupPathBox" IsReadOnly="True"/>
              </DockPanel>

              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Refresh" Click="ToolsRefreshBackups_Click" Background="{StaticResource AccentBrush}"/>
                <Button Content="Open selected" Click="ToolsOpenSelected_Click"/>
              </StackPanel>

              <TextBlock x:Name="ToolsBackupStatusText" DockPanel.Dock="Bottom"
                         Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>

              <TreeView x:Name="ToolsBackupTree"
                        MouseDoubleClick="ToolsBackupTree_MouseDoubleClick"/>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>

  <Border x:Name="BusyOverlay"
          Background="#66000000"
          Visibility="Collapsed"
          Cursor="Wait"
          Panel.ZIndex="100">
    <TextBlock Text="Working…"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               FontSize="16"
               FontWeight="SemiBold"
               Foreground="{StaticResource TextBrush}"/>
  </Border>
  </Grid>
</Window>
