<Window x:Class="Floowan.Desktop.CardArtConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm card art replacement"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}"
        MinWidth="720" MinHeight="480"
        Width="860" Height="560"
        FontFamily="Segoe UI">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                 TextWrapping="Wrap" Margin="0,0,0,4"/>
      <TextBlock x:Name="SubtitleText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                 Text="Review before and after, then confirm to write into the game."/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="96"
              Click="Cancel_Click"
              ToolTip="Abort without writing to the game. Live card art is left unchanged."/>
      <Button x:Name="ConfirmButton" Content="Confirm" IsDefault="True" MinWidth="96"
              Background="{StaticResource AccentBrush}"
              Click="Confirm_Click"
              ToolTip="Apply the replacement: create or keep backup, then write the new art into the live AssetBundle."/>
    </StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="10">
        <DockPanel>
          <TextBlock x:Name="BeforeHeaderText" DockPanel.Dock="Top" Text="Before (current live art)"
                     FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock x:Name="BeforeMetaText" DockPanel.Dock="Top"
                     Foreground="{StaticResource MutedBrush}" FontSize="12"
                     TextWrapping="Wrap" Margin="0,0,0,8"/>
          <Border Background="#12161A" CornerRadius="4">
            <Image x:Name="BeforeImage" Stretch="Uniform" Margin="8"
                   ToolTip="Current live illustration extracted from the card AssetBundle."/>
          </Border>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="10">
        <DockPanel>
          <TextBlock x:Name="AfterHeaderText" DockPanel.Dock="Top" Text="After (replacement)"
                     FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock x:Name="AfterMetaText" DockPanel.Dock="Top"
                     Foreground="{StaticResource MutedBrush}" FontSize="12"
                     TextWrapping="Wrap" Margin="0,0,0,8"/>
          <Border Background="#12161A" CornerRadius="4">
            <Image x:Name="AfterImage" Stretch="Uniform" Margin="8"
                   ToolTip="Prepared replacement image that will be written on Confirm."/>
          </Border>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>