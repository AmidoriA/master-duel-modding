<Window x:Class="Floowan.Desktop.CustomOverframeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom overframe art"
        Height="760" Width="1020"
        MinHeight="620" MinWidth="880"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Window.Resources>
    <!-- Subject source choice: the whole tile is the radio. A visible dot, a hover border and
         an accent border/background when checked make the active source obvious. -->
    <Style x:Key="SubjectSourceTile" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Tile"
                    Background="{StaticResource ControlBgBrush}"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="10,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="14" Height="14" Margin="0,2,10,0" VerticalAlignment="Top">
                  <Ellipse x:Name="Ring" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5"/>
                  <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                </Grid>
                <ContentPresenter Grid.Column="1"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Tile" Property="BorderBrush" Value="#6B7C8C"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Tile" Property="BorderBrush" Value="#6B7C8C"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Setter TargetName="Tile" Property="Background" Value="{StaticResource SelectedBrush}"/>
                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentBrush}"/>
                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <DockPanel Margin="14">
    <TextBlock DockPanel.Dock="Top"
               Text="Choose one subject source (auto detect or pick manually) — not both. Background Cover-fills the art hole (defaults to this card's illustration; when already over-framed, prefers the pre-OF backup). Re-opening after a Custom Apply restores the saved editable stage. Art scale and Bg scale share ×0.5–×4 where ×1 = Cover fit. Pan background with H/V sliders. When subject is rembg from card art and background is card art, background scale/pan stay matched as you drag or scale the subject. Drag/scale Card Art only, then Apply. Layers: Background → Frame → Card Art → Lore."
               Foreground="{StaticResource MutedBrush}"
               TextWrapping="Wrap"
               Margin="0,0,0,10"/>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360" MinWidth="300"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*" MinWidth="360"/>
      </Grid.ColumnDefinitions>

      <!-- Left: controls -->
      <DockPanel Grid.Column="0">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
          <Button x:Name="ApplyButton" Content="Apply" Click="Apply_Click"
                  Background="{StaticResource AccentBrush}" IsEnabled="False"/>
          <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Margin="0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <TextBlock x:Name="StatusText"
                     Text="Loading card art as background…"
                     Foreground="{StaticResource MutedBrush}"
                     TextWrapping="Wrap"/>
          <ProgressBar x:Name="DownloadProgressBar"
                       Height="8"
                       Margin="0,8,0,0"
                       Minimum="0"
                       Maximum="100"
                       Visibility="Collapsed"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">
          <StackPanel>
            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,8"
                    Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="Subject"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,0,0,6"/>
                <TextBlock Text="Card Art layer (alpha cutout). Scale ×0.5–×4 (×1 = Cover, same as Bg scale) and drag this layer only."
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Choose one"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,0,0,6"/>
                <StackPanel Orientation="Vertical" Margin="0,0,0,10">
                  <RadioButton x:Name="SubjectAutoRadio"
                               Style="{StaticResource SubjectSourceTile}"
                               GroupName="CustomOfSubjectSource"
                               ToolTip="Cut out the character from this card's live art with the model below."
                               Click="SubjectAutoRadio_Click">
                    <StackPanel>
                      <TextBlock Text="Auto detect"
                                 Margin="0,0,0,4"
                                 Foreground="{StaticResource TextBrush}"/>
                      <TextBlock Text="Cut out the character from this card's current art."
                                 Foreground="{StaticResource MutedBrush}"
                                 TextWrapping="Wrap"
                                 FontSize="11"/>
                    </StackPanel>
                  </RadioButton>
                  <!-- Auto detect's setting, outside the tile so the tile stays one click target and
                       picking a model never fires Auto detect's Click. Indented under the tile text. -->
                  <Grid Margin="34,6,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CutoutModelLabel"
                               Text="Model"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,0,8,0"/>
                    <ComboBox x:Name="CutoutModelBox"
                              Grid.Column="1"
                              Margin="0"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="CutoutModelBox_SelectionChanged">
                      <ComboBoxItem x:Name="CutoutIsnetItem" Tag="isnet-anime" Content="isnet-anime (fast)"/>
                      <ComboBoxItem x:Name="CutoutSam3Item" Tag="sam3-vitmatte" Content="SAM 3 + ViTMatte (best)"/>
                    </ComboBox>
                  </Grid>
                  <RadioButton x:Name="SubjectManualRadio"
                               Style="{StaticResource SubjectSourceTile}"
                               GroupName="CustomOfSubjectSource"
                               ToolTip="Pick a PNG with existing alpha (no rembg)."
                               Click="SubjectManualRadio_Click">
                    <StackPanel>
                      <TextBlock Text="Pick manually…"
                                 Margin="0,0,0,4"
                                 Foreground="{StaticResource TextBrush}"/>
                      <TextBlock Text="Use a PNG that already has transparency."
                                 Foreground="{StaticResource MutedBrush}"
                                 TextWrapping="Wrap"
                                 FontSize="11"/>
                    </StackPanel>
                  </RadioButton>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBlock Text="Frame"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource MutedBrush}"
                             Margin="0,0,8,0"/>
                  <ComboBox x:Name="FrameStyleBox" Width="220" SelectionChanged="FrameStyleBox_SelectionChanged">
                    <ComboBoxItem Content="Effect" Tag="Effect" IsSelected="True"/>
                    <ComboBoxItem Content="Normal" Tag="Normal"/>
                    <ComboBoxItem Content="Fusion" Tag="Fusion"/>
                    <ComboBoxItem Content="Synchro" Tag="Synchro"/>
                    <ComboBoxItem Content="Xyz" Tag="Xyz"/>
                    <ComboBoxItem Content="Ritual" Tag="Ritual"/>
                    <ComboBoxItem Content="Spell" Tag="Spell"/>
                    <ComboBoxItem Content="Trap" Tag="Trap"/>
                    <ComboBoxItem Content="Link" Tag="Link"/>
                    <ComboBoxItem Content="Token" Tag="Token"/>
                    <ComboBoxItem Content="Pendulum Normal" Tag="PendulumNormal"/>
                    <ComboBoxItem Content="Pendulum Effect" Tag="PendulumEffect"/>
                    <ComboBoxItem Content="Pendulum Fusion" Tag="PendulumFusion"/>
                    <ComboBoxItem Content="Pendulum Synchro" Tag="PendulumSynchro"/>
                    <ComboBoxItem Content="Pendulum Xyz" Tag="PendulumXyz"/>
                    <ComboBoxItem Content="Pendulum Ritual" Tag="PendulumRitual"/>
                    <ComboBoxItem Content="Pendulum Token" Tag="PendulumToken"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBlock Text="Art scale"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource MutedBrush}"
                             Width="56"
                             Margin="0,0,8,0"
                             ToolTip="Shared with Bg scale: ×1 = Cover fit into the art hole."/>
                  <Slider x:Name="ArtScaleSlider"
                          Width="180"
                          Minimum="0.5"
                          Maximum="4"
                          Value="1.5"
                          TickFrequency="0.1"
                          IsSnapToTickEnabled="False"
                          VerticalAlignment="Center"
                          ValueChanged="ArtScaleSlider_ValueChanged"
                          ToolTip="×0.5–×4 relative to Cover (same range as Bg scale)."/>
                  <TextBlock x:Name="ArtScaleValueText"
                             Text="×1.50"
                             Width="48"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0"
                             Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
                <Expander x:Name="AdvancedSamExpander"
                          Header="Advanced"
                          IsExpanded="False"
                          ExpandDirection="Down"
                          Foreground="{StaticResource MutedBrush}"
                          ToolTip="Paint a region and let SAM 2 add segmented subjects to Card Art.">
                  <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Paint a masking area on live card art; SAM 2 segments objects inside it into the Card Art subject. If a subject already exists, the new mask is unioned (added), not replaced."
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Margin="0,0,0,8"/>
                    <Button x:Name="AddMoreSelectionButton"
                            Content="Add more selection…"
                            Click="AddMoreSelection_Click"
                            HorizontalAlignment="Left"
                            ToolTip="Open the paint-mask editor, then run Meta SAM 2 (ONNX) on the painted region."/>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,8">
              <StackPanel>
                <TextBlock Text="Background"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,0,0,6"/>
                <TextBlock Text="Cover-fills the art hole only (lowest layer). Scale ×0.5–×4 (×1 = Cover, same as Art scale) and pan with H/V sliders (not drag). Stays matched to subject drag/scale when both layers come from card art (rembg subject). Defaults to this card's live art."
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <StackPanel Orientation="Vertical" Margin="0,0,0,8">
                  <Button x:Name="PickBackgroundButton"
                          Content="Use custom background…"
                          Click="PickBackground_Click"
                          Margin="0,0,0,6"
                          HorizontalAlignment="Left"
                          ToolTip="Pick any image to Cover-fill the art hole."/>
                  <Button x:Name="UseCardArtBackgroundButton"
                          Content="Use card art as background"
                          Click="UseCardArtBackground_Click"
                          HorizontalAlignment="Left"
                          ToolTip="Load this card's live art as the Cover background in the art hole."/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock Text="Bg scale"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource MutedBrush}"
                             Width="56"
                             Margin="0,0,8,0"
                             ToolTip="Shared with Art scale: ×1 = Cover fit into the art hole."/>
                  <Slider x:Name="BgScaleSlider"
                          Width="180"
                          Minimum="0.5"
                          Maximum="4"
                          Value="1"
                          TickFrequency="0.1"
                          IsSnapToTickEnabled="False"
                          VerticalAlignment="Center"
                          ValueChanged="BgScaleSlider_ValueChanged"
                          ToolTip="×0.5–×4 relative to Cover (same range as Art scale). Below ×1 may not fill the hole."/>
                  <TextBlock x:Name="BgScaleValueText"
                             Text="×1.00"
                             Width="48"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0"
                             Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock Text="H pan"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource MutedBrush}"
                             Width="56"
                             Margin="0,0,8,0"/>
                  <Slider x:Name="BgPanHSlider"
                          Width="180"
                          Minimum="0"
                          Maximum="0"
                          Value="0"
                          TickFrequency="1"
                          IsSnapToTickEnabled="True"
                          VerticalAlignment="Center"
                          ValueChanged="BgPanSlider_ValueChanged"/>
                  <TextBlock x:Name="BgPanHValueText"
                             Text="0"
                             Width="48"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0"
                             Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock Text="V pan"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource MutedBrush}"
                             Width="56"
                             Margin="0,0,8,0"/>
                  <Slider x:Name="BgPanVSlider"
                          Width="180"
                          Minimum="0"
                          Maximum="0"
                          Value="0"
                          TickFrequency="1"
                          IsSnapToTickEnabled="True"
                          VerticalAlignment="Center"
                          ValueChanged="BgPanSlider_ValueChanged"/>
                  <TextBlock x:Name="BgPanVValueText"
                             Text="0"
                             Width="48"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0"
                             Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>

      <!-- Right: large OF preview -->
      <Border Grid.Column="2"
              Background="{StaticResource ControlBgBrush}"
              BorderBrush="{StaticResource ControlBorderBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="10"
              ClipToBounds="True">
        <Grid x:Name="PreviewHost" Background="Transparent"
              Cursor="SizeAll"
              PreviewMouseLeftButtonDown="Preview_MouseLeftButtonDown"
              MouseMove="Preview_MouseMove"
              MouseLeftButtonUp="Preview_MouseLeftButtonUp"
              MouseLeave="Preview_MouseLeave"
              LostMouseCapture="Preview_LostMouseCapture">
          <!-- Full OF card stays fixed; only SubjectOverlay translates while dragging. -->
          <Image x:Name="PreviewImage"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 IsHitTestVisible="False"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <Image x:Name="SubjectOverlay"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Visibility="Collapsed"
                 IsHitTestVisible="False"
                 RenderOptions.BitmapScalingMode="HighQuality">
            <Image.RenderTransform>
              <TranslateTransform x:Name="SubjectDragTransform"/>
            </Image.RenderTransform>
          </Image>
          <TextBlock x:Name="PreviewHintText"
                     Text="Loading background…"
                     Foreground="{StaticResource MutedBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False"/>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>
