<Window x:Class="Floowan.Desktop.CustomOverframeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom overframe art"
        Height="780" Width="540"
        MinHeight="560" MinWidth="420"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <DockPanel Margin="14">
    <TextBlock DockPanel.Dock="Top"
               Text="Pick a subject image, drag to position, then Apply to the selected card."
               Foreground="{StaticResource MutedBrush}"
               TextWrapping="Wrap"
               Margin="0,0,0,10"/>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <Button x:Name="PickImageButton" Content="Select 704×1024 image…" Click="PickImage_Click"/>
      <TextBlock Text="Frame" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
      <ComboBox x:Name="FrameStyleBox" Width="170" Margin="0,0,8,0" SelectionChanged="FrameStyleBox_SelectionChanged">
        <ComboBoxItem Content="Effect" Tag="Effect" IsSelected="True"/>
        <ComboBoxItem Content="Normal" Tag="Normal"/>
        <ComboBoxItem Content="Fusion" Tag="Fusion"/>
        <ComboBoxItem Content="Synchro" Tag="Synchro"/>
        <ComboBoxItem Content="Xyz" Tag="Xyz"/>
        <ComboBoxItem Content="Ritual" Tag="Ritual"/>
        <ComboBoxItem Content="Spell" Tag="Spell"/>
        <ComboBoxItem Content="Trap" Tag="Trap"/>
        <ComboBoxItem Content="Link" Tag="Link"/>
        <ComboBoxItem Content="Token" Tag="Token"/>
        <ComboBoxItem Content="Pendulum Normal" Tag="PendulumNormal"/>
        <ComboBoxItem Content="Pendulum Effect" Tag="PendulumEffect"/>
        <ComboBoxItem Content="Pendulum Fusion" Tag="PendulumFusion"/>
        <ComboBoxItem Content="Pendulum Synchro" Tag="PendulumSynchro"/>
        <ComboBoxItem Content="Pendulum Xyz" Tag="PendulumXyz"/>
        <ComboBoxItem Content="Pendulum Ritual" Tag="PendulumRitual"/>
        <ComboBoxItem Content="Pendulum Token" Tag="PendulumToken"/>
      </ComboBox>
    </StackPanel>

    <TextBlock x:Name="StatusText"
               DockPanel.Dock="Top"
               Text="No image selected."
               Foreground="{StaticResource MutedBrush}"
               TextWrapping="Wrap"
               Margin="0,0,0,8"/>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="ApplyButton" Content="Apply" Click="Apply_Click"
              Background="{StaticResource AccentBrush}" IsEnabled="False"/>
      <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Margin="0"/>
    </StackPanel>

    <Border Background="{StaticResource ControlBgBrush}"
            BorderBrush="{StaticResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="8"
            ClipToBounds="True">
      <Grid x:Name="PreviewHost" Background="Transparent"
            MouseLeftButtonDown="Preview_MouseLeftButtonDown"
            MouseMove="Preview_MouseMove"
            MouseLeftButtonUp="Preview_MouseLeftButtonUp"
            MouseLeave="Preview_MouseLeave"
            LostMouseCapture="Preview_LostMouseCapture">
        <Image x:Name="PreviewImage"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"
               Cursor="SizeAll">
          <Image.RenderTransform>
            <TranslateTransform x:Name="PreviewDragTransform"/>
          </Image.RenderTransform>
        </Image>
        <TextBlock x:Name="PreviewHintText"
                   Text="Select an image to preview"
                   Foreground="{StaticResource MutedBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"/>
      </Grid>
    </Border>
  </DockPanel>
</Window>