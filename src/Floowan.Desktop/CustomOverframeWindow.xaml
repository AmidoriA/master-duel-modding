<Window x:Class="Floowan.Desktop.CustomOverframeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom overframe art"
        Height="820" Width="560"
        MinHeight="600" MinWidth="440"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <DockPanel Margin="14">
    <TextBlock DockPanel.Dock="Top"
               Text="Subject is Card Art with alpha (file or rembg from live art). Background Cover-fills the art hole (defaults to this card's live art). Scale/drag Card Art only, then Apply. Layers: Background → Frame → Card Art → Lore."
               Foreground="{StaticResource MutedBrush}"
               TextWrapping="Wrap"
               Margin="0,0,0,10"/>

    <Border DockPanel.Dock="Top"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10,8"
            Margin="0,0,0,8">
      <StackPanel>
        <TextBlock Text="Subject"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}"
                   Margin="0,0,0,6"/>
        <TextBlock Text="Card Art layer (alpha cutout). Scale and drag this layer only."
                   Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Button x:Name="PickImageButton"
                  Content="Select subject…"
                  Click="PickImage_Click"
                  Margin="0,0,8,0"
                  ToolTip="Pick a PNG with existing alpha (no rembg)."/>
          <Button x:Name="FromCurrentArtRembgButton"
                  Content="From current art (rembg)…"
                  Click="FromCurrentArtRembg_Click"
                  Margin="0,0,0,0"
                  ToolTip="Extract this card's live art, run rembg, and use the cutout as the Card Art subject layer."/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <TextBlock Text="Frame"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource MutedBrush}"
                     Margin="0,0,8,0"/>
          <ComboBox x:Name="FrameStyleBox" Width="170" SelectionChanged="FrameStyleBox_SelectionChanged">
            <ComboBoxItem Content="Effect" Tag="Effect" IsSelected="True"/>
            <ComboBoxItem Content="Normal" Tag="Normal"/>
            <ComboBoxItem Content="Fusion" Tag="Fusion"/>
            <ComboBoxItem Content="Synchro" Tag="Synchro"/>
            <ComboBoxItem Content="Xyz" Tag="Xyz"/>
            <ComboBoxItem Content="Ritual" Tag="Ritual"/>
            <ComboBoxItem Content="Spell" Tag="Spell"/>
            <ComboBoxItem Content="Trap" Tag="Trap"/>
            <ComboBoxItem Content="Link" Tag="Link"/>
            <ComboBoxItem Content="Token" Tag="Token"/>
            <ComboBoxItem Content="Pendulum Normal" Tag="PendulumNormal"/>
            <ComboBoxItem Content="Pendulum Effect" Tag="PendulumEffect"/>
            <ComboBoxItem Content="Pendulum Fusion" Tag="PendulumFusion"/>
            <ComboBoxItem Content="Pendulum Synchro" Tag="PendulumSynchro"/>
            <ComboBoxItem Content="Pendulum Xyz" Tag="PendulumXyz"/>
            <ComboBoxItem Content="Pendulum Ritual" Tag="PendulumRitual"/>
            <ComboBoxItem Content="Pendulum Token" Tag="PendulumToken"/>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Art scale"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource MutedBrush}"
                     Margin="0,0,8,0"/>
          <Slider x:Name="ArtScaleSlider"
                  Width="200"
                  Minimum="0.5"
                  Maximum="2"
                  Value="1.5"
                  TickFrequency="0.1"
                  IsSnapToTickEnabled="False"
                  VerticalAlignment="Center"
                  ValueChanged="ArtScaleSlider_ValueChanged"/>
          <TextBlock x:Name="ArtScaleValueText"
                     Text="×1.50"
                     Width="48"
                     VerticalAlignment="Center"
                     Margin="8,0,0,0"
                     Foreground="{StaticResource TextBrush}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10,8"
            Margin="0,0,0,8">
      <StackPanel>
        <TextBlock Text="Background"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}"
                   Margin="0,0,0,6"/>
        <TextBlock Text="Cover-fills the art hole only (fixed; does not move with Card Art). Defaults to this card's live art."
                   Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="PickBackgroundButton"
                  Content="Use custom background…"
                  Click="PickBackground_Click"
                  Margin="0,0,8,0"
                  ToolTip="Pick any image to Cover-fill the art hole."/>
          <Button x:Name="UseCardArtBackgroundButton"
                  Content="Use card art as background"
                  Click="UseCardArtBackground_Click"
                  Margin="0,0,0,0"
                  ToolTip="Load this card's live art as the Cover background in the art hole."/>
        </StackPanel>
      </StackPanel>
    </Border>

    <TextBlock x:Name="StatusText"
               DockPanel.Dock="Top"
               Text="Loading card art as background…"
               Foreground="{StaticResource MutedBrush}"
               TextWrapping="Wrap"
               Margin="0,0,0,8"/>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="ApplyButton" Content="Apply" Click="Apply_Click"
              Background="{StaticResource AccentBrush}" IsEnabled="False"/>
      <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Margin="0"/>
    </StackPanel>

    <Border Background="{StaticResource ControlBgBrush}"
            BorderBrush="{StaticResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="8"
            ClipToBounds="True">
      <Grid x:Name="PreviewHost" Background="Transparent"
            MouseLeftButtonDown="Preview_MouseLeftButtonDown"
            MouseMove="Preview_MouseMove"
            MouseLeftButtonUp="Preview_MouseLeftButtonUp"
            MouseLeave="Preview_MouseLeave"
            LostMouseCapture="Preview_LostMouseCapture">
        <!-- Full OF card stays fixed; only SubjectOverlay translates while dragging. -->
        <Image x:Name="PreviewImage"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"
               Cursor="SizeAll"/>
        <Image x:Name="SubjectOverlay"
               Stretch="Uniform"
               Visibility="Collapsed"
               IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality">
          <Image.RenderTransform>
            <TranslateTransform x:Name="SubjectDragTransform"/>
          </Image.RenderTransform>
        </Image>
        <TextBlock x:Name="PreviewHintText"
                   Text="Loading background…"
                   Foreground="{StaticResource MutedBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"/>
      </Grid>
    </Border>
  </DockPanel>
</Window>
