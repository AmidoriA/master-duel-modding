<Window x:Class="Floowan.Desktop.CardPickDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select cards"
        Height="520" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        ResizeMode="CanResizeWithGrip"
        MinHeight="360" MinWidth="420">
  <DockPanel Margin="16">
    <TextBlock x:Name="IntroText" DockPanel.Dock="Top" TextWrapping="Wrap"
               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="OkButton" Content="OK" IsDefault="True" Click="Ok_Click"
              Background="{StaticResource AccentBrush}" Padding="16,6" Margin="0,0,8,0"/>
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Click="Cancel_Click" Padding="16,6" Margin="0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
      <Button x:Name="SelectAllButton" Content="Select all" Click="SelectAll_Click" Margin="0,0,8,0"/>
      <Button x:Name="SelectNoneButton" Content="Select none" Click="SelectNone_Click" Margin="0,0,8,0"/>
      <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
    </StackPanel>
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource ControlBorderBrush}"
            BorderThickness="1" CornerRadius="3" Padding="4">
      <ListBox x:Name="CardList" Background="Transparent" BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                      Content="{Binding Label}"
                      Margin="4,3"
                      Foreground="{StaticResource TextBrush}"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</Window>
