<Window x:Class="Floowan.Desktop.CardPickDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select cards"
        Height="640" Width="920"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        ResizeMode="CanResizeWithGrip"
        MinHeight="420" MinWidth="700"
        Closed="Window_Closed">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock x:Name="IntroText" TextWrapping="Wrap"
                 Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
      <DockPanel>
        <TextBlock x:Name="SearchLabel" Text="Search" Width="56" VerticalAlignment="Center"
                   Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"/>
      </DockPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="OkButton" Content="OK" IsDefault="True" Click="Ok_Click"
              Background="{StaticResource AccentBrush}" Padding="16,6" Margin="0,0,8,0"/>
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Click="Cancel_Click" Padding="16,6" Margin="0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
      <Button x:Name="SelectAllButton" Content="Select all" Click="SelectAll_Click" Margin="0,0,8,0"/>
      <Button x:Name="SelectNoneButton" Content="Select none" Click="SelectNone_Click" Margin="0,0,8,0"/>
      <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="220"/>
      </Grid.ColumnDefinitions>
      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource ControlBorderBrush}"
              BorderThickness="1" CornerRadius="3" Padding="6" Margin="0,0,8,0">
        <ScrollViewer x:Name="CardScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      ScrollChanged="CardScrollViewer_ScrollChanged"
                      SizeChanged="CardScrollViewer_SizeChanged">
          <ItemsControl x:Name="CardList">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="108" Margin="4" Padding="4" CornerRadius="3"
                        Cursor="Hand" ToolTip="{Binding Label}"
                        MouseLeftButtonUp="CardCell_MouseLeftButtonUp">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="#12161A"/>
                      <Setter Property="BorderBrush" Value="#3A4652"/>
                      <Setter Property="BorderThickness" Value="1"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                          <Setter Property="Background" Value="#1A3328"/>
                          <Setter Property="BorderBrush" Value="#2F9E6B"/>
                          <Setter Property="BorderThickness" Value="2"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <Grid Width="92" Height="130" HorizontalAlignment="Center">
                      <Border Width="76" Height="110" Background="#0C1014" CornerRadius="2"
                              BorderBrush="#3A4652" BorderThickness="1"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Width="72" Height="104" Stretch="Uniform"
                               Source="{Binding Thumbnail}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <!-- Visual only: cell click toggles IsSelected; hit-testing off avoids double-toggle. -->
                      <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}"
                                IsHitTestVisible="False" Focusable="False"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="0,0,0,0"/>
                      <TextBlock Text="OF" FontSize="9" FontWeight="SemiBold" Foreground="#7DCEA0"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                                 Visibility="{Binding IsOverframe, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                               TextAlignment="Center" FontSize="10" Margin="0,4,0,0" MaxWidth="100"
                               ToolTip="{Binding Name}"/>
                    <TextBlock Text="{Binding BadgeText}" TextTrimming="CharacterEllipsis"
                               TextAlignment="Center" FontSize="9" Margin="0,1,0,0" MaxWidth="100"
                               Foreground="{StaticResource MutedBrush}"
                               Visibility="{Binding HasBadgeText, Converter={StaticResource BoolToVisibilityConverter}}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
      <Border Grid.Column="1" Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource ControlBorderBrush}"
              BorderThickness="1" CornerRadius="3" Padding="8">
        <DockPanel>
          <TextBlock x:Name="SelectedSidebarHeader" DockPanel.Dock="Top"
                     FontWeight="SemiBold" Margin="0,0,0,8"
                     Foreground="{StaticResource TextBrush}" Text="Selected"/>
          <TextBlock x:Name="SelectedSidebarEmpty" DockPanel.Dock="Top"
                     Foreground="{StaticResource MutedBrush}" FontSize="11"
                     TextWrapping="Wrap" Margin="0,0,0,6"
                     Text="No cards selected."/>
          <ListBox x:Name="SelectedSidebarList" Background="Transparent" BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   DisplayMemberPath="Name"
                   MouseLeftButtonUp="SelectedSidebarList_MouseLeftButtonUp">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="4,3"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
