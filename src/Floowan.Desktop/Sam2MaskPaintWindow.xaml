<Window x:Class="Floowan.Desktop.Sam2MaskPaintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAM 2 — add selection"
        Height="740" Width="680"
        MinHeight="540" MinWidth="520"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
  <DockPanel Margin="14">
    <TextBlock x:Name="HelpText"
               DockPanel.Dock="Top"
               Text="Working selection tint uses the Color swatches. Modes: Click (default) · Lasso · Paint. Undo restores prior selection."
               Foreground="{StaticResource MutedBrush}"
               TextWrapping="Wrap"
               Margin="0,0,0,10"/>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock Text="Mode"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource MutedBrush}"
                   Width="48"
                   Margin="0,0,8,0"/>
        <RadioButton x:Name="ClickModeRadio"
                     GroupName="SamEditorMode"
                     Content="Click object"
                     IsChecked="True"
                     VerticalAlignment="Center"
                     Margin="0,0,12,0"
                     Checked="ModeRadio_Checked"
                     ToolTip="Left-click adds a SAM object; right-click removes one (including prior-session subject)."/>
        <RadioButton x:Name="LassoModeRadio"
                     GroupName="SamEditorMode"
                     Content="Lasso"
                     VerticalAlignment="Center"
                     Margin="0,0,12,0"
                     Checked="ModeRadio_Checked"
                     ToolTip="Draw a freehand lasso. On release, fill the polygon, run SAM 2, and union into the working selection."/>
        <RadioButton x:Name="PaintModeRadio"
                     GroupName="SamEditorMode"
                     Content="Paint"
                     VerticalAlignment="Center"
                     Checked="ModeRadio_Checked"
                     ToolTip="Left-drag paints, right-drag erases amber. On release, SAM 2 runs and unions into the working selection."/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock Text="Color"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource MutedBrush}"
                   Width="48"
                   Margin="0,0,8,0"
                   ToolTip="Highlight color for the active working selection overlay."/>
        <RadioButton x:Name="ColorSwatchCyan"
                     GroupName="SamHighlightColor"
                     VerticalAlignment="Center"
                     Margin="0,0,10,0"
                     Checked="HighlightColor_Checked"
                     Tag="0"
                     ToolTip="Cyan selection highlight">
          <Border Width="18" Height="18" CornerRadius="3" Background="#28C8E6"
                  BorderBrush="#F2F2F2" BorderThickness="1"/>
        </RadioButton>
        <RadioButton x:Name="ColorSwatchGreen"
                     GroupName="SamHighlightColor"
                     VerticalAlignment="Center"
                     Margin="0,0,10,0"
                     Checked="HighlightColor_Checked"
                     Tag="1"
                     ToolTip="Green selection highlight">
          <Border Width="18" Height="18" CornerRadius="3" Background="#28D246"
                  BorderBrush="#F2F2F2" BorderThickness="1"/>
        </RadioButton>
        <RadioButton x:Name="ColorSwatchMagenta"
                     GroupName="SamHighlightColor"
                     VerticalAlignment="Center"
                     Margin="0,0,10,0"
                     Checked="HighlightColor_Checked"
                     Tag="2"
                     ToolTip="Magenta selection highlight">
          <Border Width="18" Height="18" CornerRadius="3" Background="#E63CC8"
                  BorderBrush="#F2F2F2" BorderThickness="1"/>
        </RadioButton>
        <RadioButton x:Name="ColorSwatchOrange"
                     GroupName="SamHighlightColor"
                     VerticalAlignment="Center"
                     Margin="0,0,10,0"
                     Checked="HighlightColor_Checked"
                     Tag="3"
                     ToolTip="Orange selection highlight">
          <Border Width="18" Height="18" CornerRadius="3" Background="#FF8C28"
                  BorderBrush="#F2F2F2" BorderThickness="1"/>
        </RadioButton>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <Button x:Name="UndoButton"
                Content="Undo"
                Click="Undo_Click"
                IsEnabled="False"
                Margin="0,0,8,0"
                ToolTip="Undo the last selection change (Ctrl+Z). Up to 20 steps."/>
        <Button x:Name="ResetSelectionButton"
                Content="Reset selection"
                Click="ClearClickPreview_Click"
                Margin="0,0,8,0"
                ToolTip="Reset the working selection to the prior-session subject (or empty)."/>
        <StackPanel x:Name="PaintToolsPanel" Orientation="Horizontal" Visibility="Collapsed">
          <TextBlock Text="Brush"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource MutedBrush}"
                     Width="48"
                     Margin="0,0,8,0"/>
          <Slider x:Name="BrushSizeSlider"
                  Width="160"
                  Minimum="4"
                  Maximum="96"
                  Value="28"
                  TickFrequency="1"
                  IsSnapToTickEnabled="True"
                  VerticalAlignment="Center"
                  ValueChanged="BrushSizeSlider_ValueChanged"
                  ToolTip="Brush diameter in image pixels."/>
          <TextBlock x:Name="BrushSizeValueText"
                     Text="28 px"
                     Width="56"
                     VerticalAlignment="Center"
                     Margin="8,0,0,0"
                     Foreground="{StaticResource TextBrush}"/>
          <Button x:Name="ClearMaskButton"
                  Content="Clear paint"
                  Click="ClearMask_Click"
                  Margin="12,0,0,0"
                  ToolTip="Clear the amber paint prompt only (keeps the working selection)."/>
        </StackPanel>
      </StackPanel>
      <DockPanel>
        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Left"
                   Text="Click object: left-click to add, right-click to remove."
                   Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="ApplyButton"
                  Content="Apply selection"
                  Click="Apply_Click"
                  Background="{StaticResource AccentBrush}"
                  Margin="0,0,8,0"
                  ToolTip="Write the working selection back to Card Art."/>
          <Button Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
      </DockPanel>
    </StackPanel>

    <Border Background="{StaticResource ControlBgBrush}"
            BorderBrush="{StaticResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="8"
            ClipToBounds="True">
      <Grid x:Name="PaintHost"
            Background="Transparent"
            Cursor="Cross"
            MouseLeftButtonDown="PaintHost_MouseLeftButtonDown"
            MouseRightButtonDown="PaintHost_MouseRightButtonDown"
            MouseMove="PaintHost_MouseMove"
            MouseLeftButtonUp="PaintHost_MouseLeftButtonUp"
            MouseRightButtonUp="PaintHost_MouseRightButtonUp"
            MouseLeave="PaintHost_MouseLeave"
            MouseEnter="PaintHost_MouseEnter"
            LostMouseCapture="PaintHost_LostMouseCapture">
        <Image x:Name="ArtImage"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <!-- HighQuality scales soft highlight alphas; overlays are display-only (OF cutout stays binary). -->
        <Image x:Name="ExistingSubjectOverlay"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsHitTestVisible="False"
               Visibility="Collapsed"
               Opacity="0.55"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <Image x:Name="MaskOverlay"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsHitTestVisible="False"
               Opacity="0.55"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <Image x:Name="ClickPreviewOverlay"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsHitTestVisible="False"
               Visibility="Collapsed"
               Opacity="0.55"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <Polyline x:Name="LassoPolyline"
                  Stroke="#FFC84A"
                  StrokeThickness="2"
                  StrokeLineJoin="Round"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  SnapsToDevicePixels="False"
                  IsHitTestVisible="False"
                  Visibility="Collapsed"/>
        <Ellipse x:Name="BrushCursor"
                 Width="28"
                 Height="28"
                 Stroke="#F2F2F2"
                 StrokeThickness="1.5"
                 Fill="#33FFFFFF"
                 SnapsToDevicePixels="False"
                 IsHitTestVisible="False"
                 Visibility="Collapsed"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"/>
      </Grid>
    </Border>
  </DockPanel>
</Window>
