<Window x:Class="Floowan.Desktop.Sam2MaskPaintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAM 2 — paint selection"
        Height="720" Width="640"
        MinHeight="520" MinWidth="480"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
  <DockPanel Margin="14">
    <TextBlock DockPanel.Dock="Top"
               Text="Paint (left-drag) or erase (right-drag) the prompt region. Green = already in Card Art; yellow = new paint. Esc cancels."
               Foreground="{StaticResource MutedBrush}"
               TextWrapping="Wrap"
               Margin="0,0,0,10"/>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock Text="Brush"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource MutedBrush}"
                   Width="48"
                   Margin="0,0,8,0"/>
        <Slider x:Name="BrushSizeSlider"
                Width="180"
                Minimum="4"
                Maximum="96"
                Value="28"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                VerticalAlignment="Center"
                ValueChanged="BrushSizeSlider_ValueChanged"
                ToolTip="Brush diameter in image pixels."/>
        <TextBlock x:Name="BrushSizeValueText"
                   Text="28 px"
                   Width="56"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0"
                   Foreground="{StaticResource TextBrush}"/>
        <Button x:Name="ClearMaskButton"
                Content="Clear paint"
                Click="ClearMask_Click"
                Margin="16,0,0,0"
                ToolTip="Erase the new paint strokes only (keeps the green already-added highlight)."/>
      </StackPanel>
      <DockPanel>
        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Left"
                   Text="Left-drag paints, right-drag erases. Apply when ready."
                   Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="ApplyButton"
                  Content="Apply selection"
                  Click="Apply_Click"
                  Background="{StaticResource AccentBrush}"
                  Margin="0,0,8,0"
                  ToolTip="Run SAM 2 on the painted region."/>
          <Button Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
      </DockPanel>
    </StackPanel>

    <Border Background="{StaticResource ControlBgBrush}"
            BorderBrush="{StaticResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="8"
            ClipToBounds="True">
      <Grid x:Name="PaintHost"
            Background="Transparent"
            Cursor="None"
            MouseLeftButtonDown="PaintHost_MouseLeftButtonDown"
            MouseRightButtonDown="PaintHost_MouseRightButtonDown"
            MouseMove="PaintHost_MouseMove"
            MouseLeftButtonUp="PaintHost_MouseLeftButtonUp"
            MouseRightButtonUp="PaintHost_MouseRightButtonUp"
            MouseLeave="PaintHost_MouseLeave"
            MouseEnter="PaintHost_MouseEnter"
            LostMouseCapture="PaintHost_LostMouseCapture">
        <Image x:Name="ArtImage"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <!-- Already-added subject (green), under new paint. -->
        <Image x:Name="ExistingSubjectOverlay"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsHitTestVisible="False"
               Visibility="Collapsed"
               Opacity="0.55"
               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        <!-- New paint strokes (yellow/amber). -->
        <Image x:Name="MaskOverlay"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsHitTestVisible="False"
               Opacity="0.55"
               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        <!-- Brush-size circle cursor (host coordinates). -->
        <Ellipse x:Name="BrushCursor"
                 Width="28"
                 Height="28"
                 Stroke="#F2F2F2"
                 StrokeThickness="1.5"
                 Fill="#33FFFFFF"
                 IsHitTestVisible="False"
                 Visibility="Collapsed"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"/>
      </Grid>
    </Border>
  </DockPanel>
</Window>
