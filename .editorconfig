# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,xaml,csproj,sln,md,mdc,json,yml,yaml,xml,props,targets,gitignore,gitattributes}]
indent_style = space

[*.{png,jpg,jpeg,gif,webp,ico,bmp,db,sqlite,dll,exe,pdb,tpk,zip,7z,nupkg,woff,woff2,ttf,otf,bin}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
